# =============================================================
# Home Server Environment Variables
# Copy to .env and fill in all values before deploying
# =============================================================

TZ=Europe/Brussels

# --- Domain ---
# For LAN-only: homeserver.local (Caddy uses internal CA)
# For Tailscale: homeserver.tail1234.ts.net (replace with your tailnet)
DOMAIN=homeserver.local

# --- Seafile ---
SEAFILE_MYSQL_ROOT_PASSWORD=CHANGE_ME
SEAFILE_MYSQL_DB_PASSWORD=CHANGE_ME
SEAFILE_ADMIN_EMAIL=admin@homeserver.local
SEAFILE_ADMIN_PASSWORD=CHANGE_ME
SEAFILE_REDIS_PASSWORD=CHANGE_ME
JWT_PRIVATE_KEY=CHANGE_ME_GENERATE_WITH_pwgen_-s_40_1

# --- Vaultwarden ---
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- Joplin ---
JOPLIN_DB_NAME=joplin
JOPLIN_DB_USER=joplin
JOPLIN_DB_PASSWORD=CHANGE_ME
JOPLIN_BASE_URL=https://joplin.homeserver.local
