# =============================================================
# Caddy Reverse Proxy Configuration
#
# Uses {$DOMAIN} from the environment. Expected shape:
#   - Production: DOMAIN is a deSEC subdomain (e.g. home.dedyn.io)
#     that matches site.acmeDomain in /etc/nixos/site.nix. Each site
#     block imports the `acme_tls` snippet below, which points at the
#     wildcard cert materialised by NixOS security.acme.
#   - LAN-only fallback: set DOMAIN to homeserver.local and remove the
#     `import acme_tls` lines; Caddy will fall back to its internal CA.
# =============================================================

# Wildcard cert for *.${DOMAIN}, issued + renewed by NixOS security.acme
# on the host, bind-mounted into the container at /etc/caddy/certs.
(acme_tls) {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
}

# Defense-in-depth headers — imported by every vhost below. Covers the
# authenticated-tailnet-peer-compromise case that tailnet-only access
# alone doesn't.
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

# Seafile
seafile.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy seafile:80
	request_body {
		max_size 10G
	}
}

# Vaultwarden
vaultwarden.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy vaultwarden:80
}

# Joplin
joplin.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy joplin:22300
}

# Portainer — HTTP upstream over the private Docker `proxy` network.
# The container exposes both 9000 (HTTP) and 9443 (self-signed HTTPS);
# proxying over HTTPS with tls_insecure_skip_verify was unauthenticated
# TLS (cert never verified), not real protection.
portainer.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy portainer:9000
}

# WUD (What's Up Docker)
wud.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy wud:3000
}

# ntfy (push notifications for operator alerts)
ntfy.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy ntfy:80
}

# AdGuard Home admin UI (runs on the host as a NixOS service, not in
# a container — reached via host.docker.internal; see extra_hosts in
# hosts/main/compose/caddy.yml).
adguard.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy host.docker.internal:3000
}
