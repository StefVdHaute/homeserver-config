# =============================================================
# Caddy Reverse Proxy Configuration
#
# {$DOMAIN} must match site.acmeDomain in /etc/nixos/site.nix.
# LAN-only: set DOMAIN=homeserver.local and remove the `import acme_tls`
# lines; Caddy then uses its internal CA.
# =============================================================

# Wildcard cert for *.${DOMAIN}, issued + renewed by NixOS security.acme
# on the host, bind-mounted into the container at /etc/caddy/certs.
(acme_tls) {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
}

# Security headers, imported by every vhost below.
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}

# Seafile
seafile.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy seafile:80
	request_body {
		max_size 10G
	}
}

# Vaultwarden
vaultwarden.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy vaultwarden:80
}

# Joplin
joplin.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy joplin:22300
}

# Portainer (HTTP over the private Docker `proxy` network)
portainer.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy portainer:9000
}

# WUD (What's Up Docker)
wud.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy wud:3000
}

# ntfy (push notifications for operator alerts)
ntfy.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy ntfy:80
}

# AdGuard Home admin UI on the host, via host.docker.internal
# (extra_hosts in hosts/main/compose/caddy.yml).
adguard.{$DOMAIN} {
	import acme_tls
	import secure_headers
	reverse_proxy host.docker.internal:3000
}
