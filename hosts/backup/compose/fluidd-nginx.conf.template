# Fluidd v1.37.7 default.conf.template plus the /webcam/ routes to go2rtc.
server {
  listen ${PORT} default_server;
  listen [::]:${PORT} default_server;

  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_proxied expired no-cache no-store private auth;
  gzip_comp_level 4;
  gzip_buffers 16 8k;
  gzip_http_version 1.1;
  gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/json application/xml;

  root /usr/share/nginx/html;

  index index.html;
  server_name _;

  client_max_body_size 0;

  proxy_request_buffering off;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate";
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Resolve go2rtc per request, so nginx also starts while go2rtc is down.
  resolver 127.0.0.11 valid=30s;
  set $go2rtc go2rtc:1984;

  location = /webcam/stream.mjpeg {
    proxy_pass http://$go2rtc/api/stream.mjpeg?src=k1c;
    proxy_buffering off;
  }

  location = /webcam/snapshot.jpg {
    proxy_pass http://$go2rtc/api/frame.jpeg?src=k1c;
  }
}
