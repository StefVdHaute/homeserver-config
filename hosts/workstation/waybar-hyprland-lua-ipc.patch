+  REQUIRE(isLuaConfigProvider("configProvider: lua\n") == true);
+  // "hyprlang" is what Hyprland emits for the legacy manager.
+  REQUIRE(isLuaConfigProvider("configProvider: hyprlang\n") == false);
+  REQUIRE(isLuaConfigProvider("configProvider:\tlua\n") == true);
